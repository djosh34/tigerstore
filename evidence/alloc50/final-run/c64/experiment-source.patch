diff --git a/internal/server/allocation.go b/internal/server/allocation.go
new file mode 100644
index 0000000..e90ad5b
--- /dev/null
+++ b/internal/server/allocation.go
@@ -0,0 +1,525 @@
+package server
+
+// Throwaway experiment: can bounded startup storage replace transient wire-Put
+// allocations without reusing retained Raft/MVCC bytes? Only TIGER_ALLOC_STRATEGY
+// ring|arena opts in. Non-Put RPCs and transport/timer/error infrastructure are
+// outside the managed scope; there is NO managed heap fallback.
+
+import (
+	"encoding/binary"
+	"os"
+	"sync"
+	"unsafe"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+
+	"github.com/djosh34/tigerstore/internal/core"
+	"github.com/djosh34/tigerstore/internal/node"
+)
+
+const (
+	allocationSlots     = 4096
+	allocationQuota     = 256
+	allocationByteQuota = 8 << 20
+	allocationBudget    = 64 << 20
+	arenaSlots          = 8
+)
+
+type allocSlot struct {
+	st                                  stream
+	workspace                           core.Workspace
+	req                                 core.Request
+	reply                               core.Reply
+	response                            [5 + putResponseSize]byte
+	output                              [3]outItem
+	index                               int
+	group                               int
+	block                               int
+	prev, next                          *allocSlot // connection's ownership list, not the ready list
+	readerRefs, frameRefs               int
+	mapRef, queueRef, nodeRef, timerRef bool
+	submitNext                          *stream
+	compNext                            *allocSlot
+}
+
+// Worst-case startup capacity (ring has the most block descriptors). This
+// zero-sized array type fails compilation if descriptors outgrow the budget.
+const (
+	allocationDriverReserve = 8 << 20
+	allocationStartupBytes  = (48 << 20) + allocationDriverReserve + allocationSlots*int(unsafe.Sizeof(allocSlot{})) + (allocationSlots/arenaSlots)*int(unsafe.Sizeof(allocGroup{})) + (allocationSlots+64+16)*int(unsafe.Sizeof(allocBlock{})) + (2*allocationSlots+allocationSlots/arenaSlots+allocationSlots+64+16)*int(unsafe.Sizeof(int(0))) + int(unsafe.Sizeof(allocationPool{}))
+)
+
+type allocationBudgetCheck [allocationBudget - allocationStartupBytes]struct{}
+
+var _ allocationBudgetCheck
+
+type allocGroup struct {
+	used, live int
+	sealed     bool
+	blocks     int
+	c          *conn
+}
+
+type allocBlock struct {
+	b     []byte
+	used  int
+	next  int
+	class int
+}
+
+type allocationPool struct {
+	mu                                                                                 sync.Mutex
+	mode                                                                               uint64
+	slots                                                                              []allocSlot
+	groups                                                                             []allocGroup
+	freeSlots, freeGroups                                                              []int
+	freeSlotHead, freeSlotCount                                                        int // fixed circular free-slot queue (ring mode)
+	blocks                                                                             []allocBlock
+	freeBlocks                                                                         [3][]int
+	heldSlots, heldBytes, peakSlots, peakBytes, denied, timerAllocations, unmanagedRPC uint64
+}
+
+func newAllocationPool() *allocationPool {
+	var mode uint64
+	switch os.Getenv("TIGER_ALLOC_STRATEGY") {
+	case "ring":
+		mode = 1
+	case "arena":
+		mode = 2
+	default:
+		return nil
+	}
+	p := &allocationPool{mode: mode, slots: make([]allocSlot, allocationSlots), groups: make([]allocGroup, allocationSlots/arenaSlots)}
+	p.freeSlots = make([]int, allocationSlots)
+	p.freeSlotCount = allocationSlots
+	p.freeGroups = make([]int, 0, len(p.groups))
+	for i := range p.slots {
+		p.slots[i].index = i
+		p.freeSlots[i] = i
+	}
+	for i := range p.groups {
+		p.freeGroups = append(p.freeGroups, i)
+	}
+	// 48MiB body capacity, not 2MiB per slot. The remaining budget covers
+	// all slot, group, block and free-list descriptors allocated here.
+	smallSize, smallCount := 2048, allocationSlots
+	if mode == 2 {
+		smallSize, smallCount = 16<<10, allocationSlots/arenaSlots
+	}
+	sizes := [3]int{smallSize, 128 << 10, 2 << 20}
+	counts := [3]int{smallCount, 64, 16}
+	totalBlocks := counts[0] + counts[1] + counts[2]
+	p.blocks = make([]allocBlock, 0, totalBlocks)
+	for class := range sizes {
+		data := make([]byte, sizes[class]*counts[class])
+		p.freeBlocks[class] = make([]int, 0, counts[class])
+		for i := 0; i < counts[class]; i++ {
+			p.freeBlocks[class] = append(p.freeBlocks[class], len(p.blocks))
+			p.blocks = append(p.blocks, allocBlock{b: data[i*sizes[class] : (i+1)*sizes[class]], next: -1, class: class})
+		}
+	}
+	// The compile-time allocationBudgetCheck below guards startup capacity,
+	// including a conservative 8MiB reserve for core/node list and map backing.
+	return p
+}
+
+// AllocationStats snapshots actual managed reservations. Arena slots/bytes are
+// charged for the WHOLE region until its last reader/node/timer/flush owner
+// retires; unused capacity is not mislabeled free. Snapshot allocation itself
+// is observer overhead, not managed fallback.
+func (s *Server) AllocationStats() map[string]uint64 {
+	m := map[string]uint64{"mode": 0, "slot_budget": 0, "byte_budget": 0, "per_connection_slots": 0, "held_slots": 0, "held_bytes": 0, "peak_slots": 0, "peak_bytes": 0, "denied_count": 0, "fallback_allocations": 0}
+	if s.alloc == nil {
+		return m
+	}
+	p := s.alloc
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	m["mode"], m["slot_budget"], m["byte_budget"], m["per_connection_slots"] = p.mode, allocationSlots, allocationBudget, allocationQuota
+	m["held_slots"], m["held_bytes"], m["peak_slots"], m["peak_bytes"] = p.heldSlots, p.heldBytes+allocationDriverReserve, p.peakSlots, p.peakBytes+allocationDriverReserve
+	m["driver_reserve_bytes"] = allocationDriverReserve
+	m["denied_count"] = p.denied
+	m["timer_allocations"], m["unmanaged_rpc_count"] = p.timerAllocations, p.unmanagedRPC
+	m["per_connection_bytes"] = allocationByteQuota
+	return m
+}
+
+func (p *allocationPool) peaks() {
+	p.peakSlots = max(p.peakSlots, p.heldSlots)
+	p.peakBytes = max(p.peakBytes, p.heldBytes)
+}
+
+// acquireSlot runs with c.mu. Allocation mutex never calls back into a conn.
+func (c *conn) acquireSlot() *stream {
+	p := c.s.alloc
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	var slot *allocSlot
+	if p.mode == 1 {
+		if c.allocSlots >= allocationQuota || p.freeSlotCount == 0 {
+			p.denied++
+			return nil
+		}
+		i := p.freeSlots[p.freeSlotHead]
+		p.freeSlotHead = (p.freeSlotHead + 1) % allocationSlots
+		p.freeSlotCount--
+		slot = &p.slots[i]
+		slot.group = -1
+		c.allocSlots++
+		p.heldSlots++
+		p.heldBytes += uint64(unsafe.Sizeof(allocSlot{}))
+	} else {
+		if c.arena < 0 {
+			if c.allocSlots+arenaSlots > allocationQuota || len(p.freeGroups) == 0 {
+				p.denied++
+				return nil
+			}
+			i := p.freeGroups[len(p.freeGroups)-1]
+			p.freeGroups = p.freeGroups[:len(p.freeGroups)-1]
+			p.groups[i] = allocGroup{blocks: -1, c: c}
+			c.arena = i
+			c.allocSlots += arenaSlots
+			p.heldSlots += arenaSlots
+			p.heldBytes += uint64(arenaSlots)*uint64(unsafe.Sizeof(allocSlot{})) + uint64(unsafe.Sizeof(allocGroup{}))
+		}
+		g := &p.groups[c.arena]
+		slot = &p.slots[c.arena*arenaSlots+g.used]
+		slot.group = c.arena
+		g.used++
+		g.live++
+		if g.used == arenaSlots {
+			g.sealed = true
+			c.arena = -1
+		}
+	}
+	slot.block = -1
+	slot.readerRefs = 1 // onHeaders owns the pointer through onEnd/admit
+	slot.mapRef = true
+	slot.st = stream{c: c, slot: slot, out: slot.output[:0]}
+	slot.next = c.allocHead
+	if slot.next != nil {
+		slot.next.prev = slot
+	}
+	c.allocHead = slot
+	p.peaks()
+	return &slot.st
+}
+
+func (c *conn) sealArenaLocked() {
+	if c.s.alloc == nil || c.arena < 0 {
+		return
+	}
+	p := c.s.alloc
+	p.mu.Lock()
+	i := c.arena
+	p.groups[i].sealed = true
+	c.arena = -1
+	p.recycleGroup(i)
+	p.mu.Unlock()
+}
+
+func (p *allocationPool) recycleGroup(i int) {
+	g := &p.groups[i]
+	if !g.sealed || g.live != 0 {
+		return
+	}
+	c := g.c
+	for block := g.blocks; block >= 0; {
+		next := p.blocks[block].next
+		p.releaseBlock(c, block)
+		block = next
+	}
+	for j := 0; j < g.used; j++ {
+		s := &p.slots[i*arenaSlots+j]
+		index := s.index
+		*s = allocSlot{index: index}
+	}
+	c.allocSlots -= arenaSlots
+	p.heldSlots -= arenaSlots
+	p.heldBytes -= uint64(arenaSlots)*uint64(unsafe.Sizeof(allocSlot{})) + uint64(unsafe.Sizeof(allocGroup{}))
+	*g = allocGroup{}
+	p.freeGroups = append(p.freeGroups, i)
+}
+
+// releaseReader pins even a pointer removed from streams by an early timer.
+func (c *conn) releaseReader(st *stream) {
+	if st == nil || st.slot == nil {
+		return
+	}
+	c.mu.Lock()
+	st.slot.readerRefs--
+	c.retireSlotLocked(st.slot)
+	c.mu.Unlock()
+}
+
+func (c *conn) retireSlotLocked(s *allocSlot) {
+	if s.mapRef || s.queueRef || s.nodeRef || s.timerRef || s.readerRefs != 0 || s.frameRefs != 0 || s.st.listed {
+		return
+	}
+	if s.prev != nil {
+		s.prev.next = s.next
+	} else {
+		c.allocHead = s.next
+	}
+	if s.next != nil {
+		s.next.prev = s.prev
+	}
+	p := c.s.alloc
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.mode == 2 {
+		g := &p.groups[s.group]
+		g.live--
+		// No slot in an arena is reused independently, even after retirement.
+		s.st.body, s.st.msg, s.st.out, s.req = nil, nil, nil, core.Request{}
+		p.recycleGroup(s.group)
+	} else {
+		for block := s.block; block >= 0; {
+			next := p.blocks[block].next
+			p.releaseBlock(c, block)
+			block = next
+		}
+		i := s.index
+		*s = allocSlot{index: i}
+		p.freeSlots[(p.freeSlotHead+p.freeSlotCount)%allocationSlots] = i
+		p.freeSlotCount++
+		c.allocSlots--
+		p.heldSlots--
+		p.heldBytes -= uint64(unsafe.Sizeof(allocSlot{}))
+	}
+}
+
+func (p *allocationPool) releaseBlock(c *conn, i int) {
+	b := &p.blocks[i]
+	p.heldBytes -= uint64(len(b.b))
+	c.allocBytes -= len(b.b)
+	b.used, b.next = 0, -1
+	p.freeBlocks[b.class] = append(p.freeBlocks[b.class], i)
+}
+
+func (st *stream) managedBody(size int) ([]byte, error) { return st.managedBytes(size, false) }
+
+func (st *stream) managedReply(size int) ([]byte, error) {
+	b, err := st.managedBytes(size, true)
+	if err != nil {
+		return nil, err
+	}
+	return b[:5], nil
+}
+
+func (st *stream) managedBytes(size int, reply bool) ([]byte, error) {
+	c, s := st.c, st.slot
+	p := c.s.alloc
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !reply && st.msgs != 0 {
+		return nil, status.Error(codes.Internal, "grpc: multiple unary messages")
+	}
+	if size > 2<<20 {
+		p.denied++
+		return nil, errAllocationFull
+	}
+	if size == 0 {
+		return s.response[:0:0], nil
+	}
+	block := -1
+	if p.mode == 2 {
+		g := &p.groups[s.group]
+		for i := g.blocks; i >= 0; i = p.blocks[i].next {
+			if len(p.blocks[i].b)-p.blocks[i].used >= size {
+				block = i
+				break
+			}
+		}
+	}
+	if block < 0 {
+		class := 0
+		for class < 2 && size > len(p.blocks[classStart(p, class)].b) {
+			class++
+		}
+		if len(p.freeBlocks[class]) == 0 {
+			p.denied++
+			return nil, errAllocationFull
+		}
+		block = p.freeBlocks[class][len(p.freeBlocks[class])-1]
+		if c.allocBytes+len(p.blocks[block].b) > allocationByteQuota {
+			p.denied++
+			return nil, errAllocationFull
+		}
+		p.freeBlocks[class] = p.freeBlocks[class][:len(p.freeBlocks[class])-1]
+		b := &p.blocks[block]
+		c.allocBytes += len(b.b)
+		p.heldBytes += uint64(len(b.b))
+		if p.mode == 2 {
+			g := &p.groups[s.group]
+			b.next = g.blocks
+			g.blocks = block
+		} else {
+			b.next = s.block
+			s.block = block
+		}
+		p.peaks()
+	}
+	b := &p.blocks[block]
+	start := b.used
+	b.used += size
+	// Exact capacity is mandatory: receive uses cap to recognize message end.
+	return b.b[start : start : start+size], nil
+}
+
+func classStart(p *allocationPool, class int) int {
+	if class == 0 {
+		return 0
+	}
+	if class == 1 {
+		if p.mode == 2 {
+			return allocationSlots / arenaSlots
+		}
+		return allocationSlots
+	}
+	if p.mode == 2 {
+		return allocationSlots/arenaSlots + 64
+	}
+	return allocationSlots + 64
+}
+
+var errAllocationFull = status.Error(codes.ResourceExhausted, "allocation experiment: bounded workspace full")
+
+func (st *stream) ManagedRequest() (core.Request, any) { return st.slot.req, st }
+func (st *stream) NextManagedRequest() node.ManagedBatch {
+	if st.slot.submitNext == nil {
+		return nil
+	}
+	return st.slot.submitNext
+}
+
+// queueManaged establishes ownership BEFORE flush, reset, or deadline can run.
+func (c *conn) queueManaged(st *stream, req core.Request) {
+	c.mu.Lock()
+	req.Workspace = &st.slot.workspace
+	st.slot.req = req
+	st.slot.queueRef = true
+	if c.managedTail == nil {
+		c.managedHead = st
+	} else {
+		c.managedTail.slot.submitNext = st
+	}
+	c.managedTail = st
+	c.managedCount++
+	c.managedBytes += st.reqSize
+	c.mu.Unlock()
+}
+
+func (c *conn) flushManaged() error {
+	c.mu.Lock()
+	head, count := c.managedHead, c.managedCount
+	c.managedHead, c.managedTail, c.managedCount, c.managedBytes = nil, nil, 0, 0
+	c.sealArenaLocked()
+	for st := head; st != nil; st = st.slot.submitNext {
+		st.slot.queueRef = false
+		st.slot.nodeRef = true
+		st.atNode = true
+		c.holdLocked(st, st.reqSize+callCost)
+	}
+	c.mu.Unlock()
+	if head == nil {
+		return nil
+	}
+	err := c.s.n.SubmitManagedBatch(c.ctx, head, count, c)
+	if err == nil {
+		return nil
+	}
+	for st := head; st != nil; {
+		next := st.slot.submitNext // callback may retire st
+		c.CompleteOne(st, core.Reply{Err: err})
+		st = next
+	}
+	if c.ctx.Err() != nil {
+		return err
+	}
+	return nil
+}
+
+// CompleteOne is an O(1) bounded linked queue copy under compMu; the owner
+// does NOT encode or acquire c.mu unless this connection is already closed.
+// This intentionally pays one short mutex operation per completion.
+func (c *conn) CompleteOne(tag any, reply core.Reply) {
+	st := tag.(*stream)
+	s := st.slot
+	c.compMu.Lock()
+	if c.completionClosed {
+		c.compMu.Unlock()
+		c.mu.Lock()
+		s.nodeRef = false
+		st.atNode = false
+		c.releaseLocked(st)
+		c.retireSlotLocked(s)
+		c.mu.Unlock()
+		return
+	}
+	s.reply = reply
+	if c.compTail == nil {
+		c.compHead = s
+	} else {
+		c.compTail.compNext = s
+	}
+	c.compTail = s
+	c.compMu.Unlock()
+	c.signal()
+}
+
+func (c *conn) takeManagedCompletions() *allocSlot {
+	c.compMu.Lock()
+	head := c.compHead
+	c.compHead, c.compTail = nil, nil
+	c.compMu.Unlock()
+	return head
+}
+
+func (c *conn) completeManaged(head *allocSlot) {
+	for s := head; s != nil; {
+		next := s.compNext
+		st := &s.st
+		r := s.reply
+		var b []byte
+		err := r.Err
+		if err == nil {
+			b = s.response[:5]
+			if r.PrevKv != nil {
+				// Previous-key responses are variable-sized but remain bounded
+				// managed storage, not a silently allocating append fallback.
+				size := 5 + putResponseSize + 2 + binary.MaxVarintLen64 + proto.Size(r.PrevKv)
+				b, err = st.managedReply(size)
+			}
+			if err == nil {
+				b, err = appendPutResponse(b, c.s.n.ClusterID(), c.s.n.ID(), r.Rev, r.Term, r.PrevKv)
+				if err == nil {
+					binary.BigEndian.PutUint32(b[1:5], uint32(len(b)-5))
+				}
+			}
+		}
+		c.mu.Lock()
+		s.compNext = nil
+		s.reply = core.Reply{}
+		s.req = core.Request{}
+		s.nodeRef = false
+		st.atNode = false
+		if st.reset || c.closed {
+			c.releaseLocked(st)
+		} else if !st.done.Swap(true) {
+			c.holdLocked(st, len(b))
+			var statusValue *status.Status
+			if err != nil {
+				statusValue = status.Convert(toStatus(err))
+			}
+			st.pushLocked(b, true, statusValue)
+		}
+		c.retireSlotLocked(s)
+		c.mu.Unlock()
+		s = next
+	}
+}
diff --git a/internal/server/allocation_lifetime.go b/internal/server/allocation_lifetime.go
new file mode 100644
index 0000000..a90566a
--- /dev/null
+++ b/internal/server/allocation_lifetime.go
@@ -0,0 +1,63 @@
+package server
+
+// All lifetime changes below run under c.mu. A stopped timer may still have
+// an active callback: only Stop()==true transfers its reference to us.
+func (c *conn) stopDeadlineLocked(st *stream) {
+	if st.deadline != nil && st.deadline.Stop() && st.slot != nil {
+		st.slot.timerRef = false
+	}
+}
+
+func (c *conn) dropManagedCompletions(head *allocSlot) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for s := head; s != nil; {
+		next := s.compNext
+		s.compNext = nil
+		s.nodeRef = false
+		s.st.atNode = false
+		c.releaseLocked(&s.st)
+		c.retireSlotLocked(s)
+		s = next
+	}
+}
+
+// readerDone is the only cleanup that may release queued-but-unsubmitted
+// batches. close can race the reader, and must not recycle those links.
+func (c *conn) readerDone() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for st := c.managedHead; st != nil; {
+		next := st.slot.submitNext
+		st.slot.queueRef = false
+		c.retireSlotLocked(st.slot)
+		st = next
+	}
+	c.managedHead, c.managedTail, c.managedCount, c.managedBytes = nil, nil, 0, 0
+	c.sealArenaLocked()
+}
+
+func (c *conn) frameOwner(st *stream) *allocSlot {
+	if st.slot != nil {
+		st.slot.frameRefs++
+	}
+	return st.slot
+}
+
+// Writer frames retain response aliases through the ACTUAL flush, including
+// its error/abort path, not merely endStream's removal from the stream map.
+func (c *conn) retireFrames(frames []wframe) {
+	if c.s.alloc == nil {
+		clear(frames)
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for i := range frames {
+		if s := frames[i].owner; s != nil {
+			s.frameRefs--
+			c.retireSlotLocked(s)
+		}
+		frames[i] = wframe{}
+	}
+}
diff --git a/internal/server/allocation_path_test.go b/internal/server/allocation_path_test.go
new file mode 100644
index 0000000..e218a27
--- /dev/null
+++ b/internal/server/allocation_path_test.go
@@ -0,0 +1,372 @@
+package server_test
+
+// Throwaway allocation census. This is a correctness-sized test, not a
+// throughput benchmark. The process counters include the client and all three
+// nodes. The Actions experiment measures the leader process separately.
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"runtime/pprof"
+	"testing"
+	"time"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"golang.org/x/net/http2"
+	"golang.org/x/net/http2/hpack"
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+// Allocation profiling and retained-history checks use production's 100ms
+// clock. The general fixture's 10ms clock makes its disk fence only 200ms,
+// which can mistake profiler or shared-runner scheduling delays for disk loss.
+// Keep the real default election/watchdog policy and disk barriers unchanged.
+func newAllocationCluster(t *testing.T) *cluster {
+	return newClusterWith(t, func(c *cluster) { c.tick = 100 * time.Millisecond })
+}
+
+func TestAllocationPath(t *testing.T) {
+	// Never run concurrently: MemStats and the allocation profiler are global.
+	oldRate := runtime.MemProfileRate
+	runtime.MemProfileRate = 1
+	defer func() { runtime.MemProfileRate = oldRate }()
+	c := newAllocationCluster(t)
+	cert, _, _, err := c.ca.Issue("allocation-client", 191)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leader := retry(t, func(ctx context.Context) (uint64, error) {
+		st, err := pb.NewMaintenanceClient(c.dial(1, cert)).Status(ctx, &pb.StatusRequest{})
+		if err == nil && st.Leader == 0 {
+			err = errors.New("no leader")
+		}
+		return st.GetLeader(), err
+	})
+	kv := c.client(leader, cert)
+	retry(t, func(ctx context.Context) (*pb.PutResponse, error) {
+		return kv.Put(ctx, &pb.PutRequest{Key: []byte("allocation-probe"), Value: []byte("ready")})
+	})
+	conn, err := tls.Dial("tcp", c.running[leader].addr, &tls.Config{
+		Certificates: []tls.Certificate{cert}, RootCAs: c.ca.Pool,
+		ServerName: "localhost", NextProtos: []string{"h2"}, MinVersion: tls.VersionTLS13,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := conn.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	if err := conn.SetDeadline(time.Now().Add(60 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	cl, err := allocationClient(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for range 32 {
+		if err := cl.put(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	out := os.Getenv("ALLOC50_TEST_OUT")
+	profile := func(name string) {
+		if out == "" {
+			return
+		}
+		if err := os.MkdirAll(out, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		f, err := os.Create(filepath.Join(out, name+".pb.gz"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := pprof.Lookup("allocs").WriteTo(f, 0); err != nil {
+			t.Fatal(err)
+		}
+		if err := f.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// Two GCs flush delayed memory-profile accounting. Profiles are cumulative;
+	// subtract before from after with pprof -base, not by reading after alone.
+	runtime.GC()
+	runtime.GC()
+	profile("before")
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	const puts = 256
+	for range puts {
+		if err := cl.put(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	runtime.ReadMemStats(&after)
+	runtime.GC()
+	runtime.GC()
+	profile("after")
+	var retained runtime.MemStats
+	runtime.ReadMemStats(&retained)
+	result := map[string]any{
+		"scope":    "in-process client plus leader and two followers, not leader-only",
+		"strategy": os.Getenv("TIGER_ALLOC_STRATEGY"), "successful_puts": puts,
+		"leader_id": leader, "value_bytes": 1024, "mem_profile_rate": 1,
+		"mallocs_per_put":            float64(after.Mallocs-before.Mallocs) / puts,
+		"allocated_bytes_per_put":    float64(after.TotalAlloc-before.TotalAlloc) / puts,
+		"heap_alloc_after_forced_gc": retained.HeapAlloc,
+	}
+	// The index must retain immutable entry bytes after transient bodies and
+	// replies have been recycled. Check every replica outside the counters.
+	for id := uint64(1); id <= 3; id++ {
+		got := retry(t, func(ctx context.Context) (*pb.RangeResponse, error) {
+			r, err := c.client(id, cert).Range(ctx, &pb.RangeRequest{Key: []byte("allocation-probe"), Serializable: true})
+			if err == nil && uint64(r.Header.Revision) != cl.lastRev {
+				err = fmt.Errorf("replica %d has revision %d, want %d", id, r.Header.Revision, cl.lastRev)
+			}
+			return r, err
+		})
+		if len(got.Kvs) != 1 || !bytes.Equal(got.Kvs[0].Value, bytes.Repeat([]byte{0xab}, 1024)) {
+			t.Fatalf("replica %d lost the wire-backed value", id)
+		}
+	}
+	b, err := json.MarshalIndent(result, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Log(string(b))
+	if out != "" {
+		if err := os.WriteFile(filepath.Join(out, "memstats.json"), b, 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+// TestAllocationValueLifetimes catches reuse of a request body or stream slot
+// while any historical value still references it. Each overwrite has distinct
+// bytes; constant-value throughput workloads cannot catch that corruption.
+func TestAllocationValueLifetimes(t *testing.T) {
+	for _, mode := range []string{"base", "ring", "arena"} {
+		t.Run(mode, func(t *testing.T) {
+			t.Setenv("TIGER_ALLOC_STRATEGY", mode)
+			c := newAllocationCluster(t)
+			cert, _, _, err := c.ca.Issue("lifetime-client", 192)
+			if err != nil {
+				t.Fatal(err)
+			}
+			kv := c.client(1, cert)
+			type version struct {
+				key, value []byte
+				rev        int64
+			}
+			var versions []version
+			for i := range 96 {
+				key := fmt.Appendf(nil, "/alloc50/lifetime/%d", i%8)
+				value := bytes.Repeat([]byte{byte(i + 1)}, 1024+i%17)
+				r := retry(t, func(ctx context.Context) (*pb.PutResponse, error) {
+					return kv.Put(ctx, &pb.PutRequest{Key: key, Value: value})
+				})
+				versions = append(versions, version{key: key, value: value, rev: r.Header.Revision})
+			}
+			verify := func() {
+				for id := uint64(1); id <= 3; id++ {
+					client := c.client(id, cert)
+					for _, v := range versions {
+						r := retry(t, func(ctx context.Context) (*pb.RangeResponse, error) {
+							return client.Range(ctx, &pb.RangeRequest{Key: v.key, Revision: v.rev})
+						})
+						if len(r.Kvs) != 1 || r.Kvs[0].ModRevision != v.rev || !bytes.Equal(r.Kvs[0].Value, v.value) {
+							t.Fatalf("node %d, key %q, revision %d: recycled historical bytes", id, v.key, v.rev)
+						}
+					}
+				}
+			}
+			verify()
+			// Reopen every WAL after slots have been reused. Live MVCC reads
+			// alone cannot establish that the durable bytes stayed immutable.
+			for _, r := range c.running {
+				r.stop()
+			}
+			for id := uint64(1); id <= 3; id++ {
+				c.start(id)
+			}
+			verify()
+		})
+	}
+}
+
+type allocClient struct {
+	conn        *tls.Conn
+	first, next []byte
+	second      int
+	id          uint32
+	wantTrailer []byte
+	head        [9]byte
+	payload     [65536]byte
+	reply       [256]byte
+	lastRev     uint64
+}
+
+func allocationClient(conn *tls.Conn) (*allocClient, error) {
+	var pre bytes.Buffer
+	pre.WriteString(http2.ClientPreface)
+	fr := http2.NewFramer(&pre, nil)
+	if err := fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20}); err != nil {
+		return nil, err
+	}
+	if err := fr.WriteWindowUpdate(0, (16<<20)-65535); err != nil {
+		return nil, err
+	}
+	if _, err := conn.Write(pre.Bytes()); err != nil {
+		return nil, err
+	}
+	req, err := proto.Marshal(&pb.PutRequest{Key: []byte("allocation-probe"), Value: bytes.Repeat([]byte{0xab}, 1024)})
+	if err != nil {
+		return nil, err
+	}
+	msg := make([]byte, 5, 5+len(req))
+	binary.BigEndian.PutUint32(msg[1:], uint32(len(req)))
+	msg = append(msg, req...)
+	var hb bytes.Buffer
+	enc := hpack.NewEncoder(&hb)
+	fields := []hpack.HeaderField{{Name: ":method", Value: "POST"}, {Name: ":scheme", Value: "https"}, {Name: ":path", Value: "/etcdserverpb.KV/Put"}, {Name: ":authority", Value: "localhost"}, {Name: "content-type", Value: "application/grpc"}, {Name: "te", Value: "trailers"}}
+	makeRequest := func() ([]byte, int, error) {
+		hb.Reset()
+		for _, f := range fields {
+			if err := enc.WriteField(f); err != nil {
+				return nil, 0, err
+			}
+		}
+		var wire bytes.Buffer
+		fr := http2.NewFramer(&wire, nil)
+		if err := fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: hb.Bytes(), EndHeaders: true}); err != nil {
+			return nil, 0, err
+		}
+		second := wire.Len()
+		if err := fr.WriteData(1, true, msg); err != nil {
+			return nil, 0, err
+		}
+		return wire.Bytes(), second, nil
+	}
+	first, _, err := makeRequest()
+	if err != nil {
+		return nil, err
+	}
+	next, second, err := makeRequest()
+	return &allocClient{conn: conn, first: first, next: next, second: second}, err
+}
+
+func (cl *allocClient) put() error {
+	cl.id += 2
+	id := cl.id - 1
+	wire, second := cl.next, cl.second
+	if id == 1 {
+		wire = cl.first
+		second = 9 + int(wire[0])<<16 + int(wire[1])<<8 + int(wire[2])
+	}
+	binary.BigEndian.PutUint32(wire[5:9], id)
+	binary.BigEndian.PutUint32(wire[second+5:second+9], id)
+	if _, err := cl.conn.Write(wire); err != nil {
+		return err
+	}
+	replyN := 0
+	for {
+		if _, err := io.ReadFull(cl.conn, cl.head[:]); err != nil {
+			return err
+		}
+		n := int(cl.head[0])<<16 | int(cl.head[1])<<8 | int(cl.head[2])
+		if n > len(cl.payload) {
+			return fmt.Errorf("frame too large: %d", n)
+		}
+		b := cl.payload[:n]
+		if _, err := io.ReadFull(cl.conn, b); err != nil {
+			return err
+		}
+		typ, flags := http2.FrameType(cl.head[3]), http2.Flags(cl.head[4])
+		sid := binary.BigEndian.Uint32(cl.head[5:]) & 0x7fffffff
+		if typ == http2.FrameSettings && flags&http2.FlagSettingsAck == 0 {
+			ack := [9]byte{3: byte(http2.FrameSettings), 4: byte(http2.FlagSettingsAck)}
+			if _, err := cl.conn.Write(ack[:]); err != nil {
+				return err
+			}
+		}
+		if sid != id {
+			continue
+		}
+		if typ == http2.FrameRSTStream {
+			return fmt.Errorf("reset on %d: %x", sid, b)
+		}
+		if typ == http2.FrameData {
+			if replyN+n > len(cl.reply) {
+				return errors.New("reply too large")
+			}
+			replyN += copy(cl.reply[replyN:], b)
+		}
+		if typ == http2.FrameHeaders && flags&http2.FlagHeadersEndStream != 0 {
+			if cl.wantTrailer == nil {
+				fields, err := hpack.NewDecoder(4096, nil).DecodeFull(b)
+				if err != nil {
+					return err
+				}
+				ok := false
+				for _, f := range fields {
+					if f.Name == "grpc-status" && f.Value == "0" {
+						ok = true
+					}
+				}
+				if !ok {
+					return fmt.Errorf("non-OK trailer: %v", fields)
+				}
+				cl.wantTrailer = append([]byte(nil), b...)
+			} else if !bytes.Equal(b, cl.wantTrailer) {
+				return fmt.Errorf("changed trailer: %x", b)
+			}
+			return cl.validate(cl.reply[:replyN])
+		}
+	}
+}
+
+func (cl *allocClient) validate(msg []byte) error {
+	if len(msg) < 5 || int(binary.BigEndian.Uint32(msg[1:5])) != len(msg)-5 {
+		return errors.New("invalid gRPC response")
+	}
+	b := msg[5:]
+	num, typ, n := protowire.ConsumeTag(b)
+	if n < 0 || num != 1 || typ != protowire.BytesType {
+		return errors.New("missing response header")
+	}
+	h, n := protowire.ConsumeBytes(b[n:])
+	if n < 0 {
+		return errors.New("bad response header")
+	}
+	var rev uint64
+	for len(h) > 0 {
+		num, typ, n = protowire.ConsumeTag(h)
+		if n < 0 || typ != protowire.VarintType {
+			return errors.New("bad header field")
+		}
+		h = h[n:]
+		v, k := protowire.ConsumeVarint(h)
+		if k < 0 {
+			return errors.New("bad header value")
+		}
+		if num == 3 {
+			rev = v
+		}
+		h = h[k:]
+	}
+	if rev == 0 || (cl.lastRev > 0 && rev != cl.lastRev+1) {
+		return fmt.Errorf("revision %d after %d", rev, cl.lastRev)
+	}
+	cl.lastRev = rev
+	return nil
+}
diff --git a/internal/server/allocation_workspace_test.go b/internal/server/allocation_workspace_test.go
new file mode 100644
index 0000000..f7e7fe2
--- /dev/null
+++ b/internal/server/allocation_workspace_test.go
@@ -0,0 +1,231 @@
+package server
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+	"golang.org/x/net/http2/hpack"
+)
+
+func allocationFixture(t *testing.T, mode string) (*Server, *conn) {
+	t.Helper()
+	t.Setenv("TIGER_ALLOC_STRATEGY", mode)
+	s := New(nil, Config{})
+	a, b := net.Pipe()
+	c := newConn(s, a, a)
+	t.Cleanup(func() { c.close(); c.readerDone(); _ = b.Close() })
+	return s, c
+}
+
+func allocationHeaders(id uint32, timeout string) *http2.MetaHeadersFrame {
+	fields := []hpack.HeaderField{{Name: ":method", Value: "POST"}, {Name: ":path", Value: "/etcdserverpb.KV/Put"}, {Name: "content-type", Value: "application/grpc"}}
+	if timeout != "" {
+		fields = append(fields, hpack.HeaderField{Name: "grpc-timeout", Value: timeout})
+	}
+	return &http2.MetaHeadersFrame{HeadersFrame: &http2.HeadersFrame{StreamID: id}, Fields: fields}
+}
+
+func assertAllocationHeld(t *testing.T, s *Server, slots uint64) {
+	t.Helper()
+	stats := s.AllocationStats()
+	if stats["held_slots"] != slots || stats["held_bytes"] > stats["byte_budget"] || stats["peak_bytes"] > stats["byte_budget"] || stats["fallback_allocations"] != 0 {
+		t.Fatalf("held slots want %d: %v", slots, stats)
+	}
+}
+
+func TestAllocationWorkspaceQuotaAndFairness(t *testing.T) {
+	for _, mode := range []string{"ring", "arena"} {
+		t.Run(mode, func(t *testing.T) {
+			s, c := allocationFixture(t, mode)
+			for i := range allocationQuota {
+				st := c.newStream(uint32(i*2+1), allocationHeaders(uint32(i*2+1), ""))
+				if st == nil {
+					t.Fatalf("quota denied at %d", i)
+				}
+				c.releaseReader(st)
+			}
+			assertAllocationHeld(t, s, allocationQuota)
+			if st := c.newStream(999, allocationHeaders(999, "")); st != nil {
+				t.Fatal("quota did not refuse stream")
+			}
+			if s.AllocationStats()["denied_count"] != 1 {
+				t.Fatal("missing denial")
+			}
+			a, b := net.Pipe()
+			other := newConn(s, a, a)
+			st := other.newStream(1, allocationHeaders(1, ""))
+			if st == nil {
+				t.Fatal("slow connection exhausted healthy connection")
+			}
+			other.releaseReader(st)
+			other.close()
+			other.readerDone()
+			_ = b.Close()
+			c.close()
+			c.readerDone()
+			assertAllocationHeld(t, s, 0)
+		})
+	}
+}
+
+func TestAllocationWorkspaceResetBeforeFlushAndReaderPin(t *testing.T) {
+	for _, mode := range []string{"ring", "arena"} {
+		t.Run(mode, func(t *testing.T) {
+			s, c := allocationFixture(t, mode)
+			st := c.newStream(1, allocationHeaders(1, ""))
+			// A tiny valid wire Put; it is admitted but has NOT reached Submit.
+			wire := []byte{0, 0, 0, 0, 6, 10, 1, 'k', 18, 1, 'v'}
+			if err := st.receive(wire); err != nil {
+				t.Fatal(err)
+			}
+			c.admit(st)
+			c.resetStream(1, 0)
+			want := uint64(1)
+			if mode == "arena" {
+				want = arenaSlots
+			}
+			assertAllocationHeld(t, s, want)
+			c.releaseReader(st)              // map removal did not invalidate reader's pointer
+			assertAllocationHeld(t, s, want) // queued admission still owns it
+			c.readerDone()                   // abort unsubmitted batch, then seal its arena
+			assertAllocationHeld(t, s, 0)
+		})
+	}
+}
+
+func TestAllocationWorkspaceFramesPinUntilFlushOrAbort(t *testing.T) {
+	for _, mode := range []string{"ring", "arena"} {
+		t.Run(mode, func(t *testing.T) {
+			s, c := allocationFixture(t, mode)
+			st := c.newStream(1, allocationHeaders(1, ""))
+			st.inEOF = true
+			copy(st.slot.response[:], "immutable reply")
+			c.mu.Lock()
+			st.pushLocked(st.slot.response[:15], true, nil)
+			c.sealArenaLocked()
+			c.mu.Unlock()
+			c.releaseReader(st)
+			c.mu.Lock()
+			frames := c.take(nil)
+			c.mu.Unlock()
+			if len(frames) != 3 {
+				t.Fatalf("frames=%d", len(frames))
+			}
+			want := uint64(1)
+			if mode == "arena" {
+				want = arenaSlots
+			}
+			assertAllocationHeld(t, s, want)
+			if !bytes.Equal(frames[1].b, []byte("immutable reply")) {
+				t.Fatal("reply changed at endStream")
+			}
+			c.close() // abort cannot recycle frame aliases owned by writer
+			assertAllocationHeld(t, s, want)
+			c.retireFrames(frames) // same cleanup boundary used after Flush/error
+			assertAllocationHeld(t, s, 0)
+		})
+	}
+}
+
+func TestAllocationWorkspaceActiveTimerOwnsReference(t *testing.T) {
+	for _, mode := range []string{"ring", "arena"} {
+		t.Run(mode, func(t *testing.T) {
+			s, c := allocationFixture(t, mode)
+			st := c.newStream(1, allocationHeaders(1, "1H"))
+			c.mu.Lock() // let callback start, but block its push
+			c.stopDeadlineLocked(st)
+			st.deadline = nil
+			st.slot.timerRef = true
+			started := make(chan struct{})
+			st.deadline = time.AfterFunc(time.Nanosecond, func() { close(started); st.expire() })
+			<-started
+			deadline := time.Now().Add(time.Second)
+			for !st.done.Load() && time.Now().Before(deadline) {
+				time.Sleep(time.Millisecond)
+			}
+			if !st.done.Load() {
+				c.mu.Unlock()
+				t.Fatal("timer callback did not start")
+			}
+			c.stopDeadlineLocked(st)
+			if !st.slot.timerRef {
+				c.mu.Unlock()
+				t.Fatal("Stop(false) lost active callback reference")
+			}
+			st.reset = true
+			st.slot.mapRef = false
+			delete(c.streams, st.id)
+			st.slot.readerRefs--
+			c.sealArenaLocked()
+			c.retireSlotLocked(st.slot)
+			c.mu.Unlock()
+			for s.AllocationStats()["held_slots"] != 0 && time.Now().Before(deadline) {
+				time.Sleep(time.Millisecond)
+			}
+			assertAllocationHeld(t, s, 0)
+		})
+	}
+}
+
+func TestAllocationWorkspaceRawTwoMiBAndNoPrimitiveChurn(t *testing.T) {
+	for _, mode := range []string{"ring", "arena"} {
+		t.Run(mode, func(t *testing.T) {
+			s, c := allocationFixture(t, mode)
+			st := c.newStream(1, allocationHeaders(1, ""))
+			var prefix [5]byte
+			binary.BigEndian.PutUint32(prefix[1:], 2<<20)
+			if err := st.receive(prefix[:]); err != nil {
+				t.Fatal(err)
+			}
+			if cap(st.msg) != 2<<20 {
+				t.Fatalf("raw capacity=%d", cap(st.msg))
+			}
+			chunk := make([]byte, 16<<10)
+			for range 128 {
+				if err := st.receive(chunk); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if len(st.body) != 2<<20 || st.msgs != 1 {
+				t.Fatal("raw 2MiB body not accepted")
+			}
+			c.resetStream(1, 0)
+			c.releaseReader(st)
+			c.mu.Lock()
+			c.sealArenaLocked()
+			c.mu.Unlock()
+			assertAllocationHeld(t, s, 0)
+			allocs := testing.AllocsPerRun(100, func() {
+				c.mu.Lock()
+				st := c.acquireSlot()
+				c.mu.Unlock()
+				if st == nil {
+					t.Fatal("unexpected denial")
+				}
+				if _, err := st.managedBody(1024); err != nil {
+					t.Fatal(err)
+				}
+				c.mu.Lock()
+				st.slot.mapRef = false
+				st.slot.readerRefs--
+				c.retireSlotLocked(st.slot)
+				c.sealArenaLocked()
+				c.mu.Unlock()
+			})
+			if allocs != 0 {
+				t.Fatalf("bounded slot/body primitive allocations=%g", allocs)
+			}
+			assertAllocationHeld(t, s, 0)
+		})
+	}
+}
+
+func TestAllocationWorkspaceStartupBudget(t *testing.T) {
+	if allocationStartupBytes > allocationBudget {
+		t.Fatalf("startup=%d budget=%d", allocationStartupBytes, allocationBudget)
+	}
+}
