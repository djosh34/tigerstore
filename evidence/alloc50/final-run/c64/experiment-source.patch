diff --git a/experiments/alloc50/cases/main.go b/experiments/alloc50/cases/main.go
new file mode 100644
index 0000000..48a34e4
--- /dev/null
+++ b/experiments/alloc50/cases/main.go
@@ -0,0 +1,419 @@
+// Separate compatibility/slow-reader diagnostics, never a timing generator.
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"time"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/v3rpc/rpctypes"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/protobuf/proto"
+)
+
+const (
+	limit        = 1536 * 1024
+	slowAttempts = 4096
+)
+
+func raftSize(key, value []byte) int {
+	return proto.Size(&pb.InternalRaftRequest{
+		Header: &pb.RequestHeader{ID: 1 << 63},
+		Put:    &pb.PutRequest{Key: key, Value: value},
+	})
+}
+
+func valueOfSize(n int) []byte {
+	value := make([]byte, n)
+	for i := 0; i < n; i += sha256.Size {
+		sum := sha256.Sum256([]byte(fmt.Sprintf("alloc50-large-%d", i)))
+		copy(value[i:], sum[:])
+	}
+	return value
+}
+
+// slowCommittedPuts distinguishes committed writes from charged allocator
+// capacity. A singleton stream can pin an entire eight-slot arena region.
+func slowCommittedPuts(r *pb.RangeResponse, key, value []byte) (int64, error) {
+	if r == nil || r.Header == nil || r.Count != 1 || len(r.Kvs) != 1 || r.Kvs[0] == nil {
+		return 0, errors.New("slow key Range missing value or header")
+	}
+	kv := r.Kvs[0]
+	if !bytes.Equal(kv.Key, key) || !bytes.Equal(kv.Value, value) || kv.Version < 1 || kv.Version > slowAttempts {
+		return 0, errors.New("slow key Range has invalid value or committed count")
+	}
+	return kv.Version, nil
+}
+
+func run() (resultErr error) {
+	endpoint := flag.String("endpoint", "", "leader client endpoint")
+	certdir := flag.String("certdir", "", "certificate directory")
+	debugURL := flag.String("debug-url", "", "leader observation endpoint")
+	out := flag.String("out", "", "raw JSON output")
+	strategy := flag.String("strategy", "base", "base, default, ring or arena")
+	flag.Parse()
+	mode := uint64(0)
+	switch *strategy {
+	case "ring":
+		mode = 1
+	case "arena":
+		mode = 2
+	case "base", "default":
+	default:
+		return errors.New("invalid strategy")
+	}
+	report := map[string]any{
+		"valid": false, "slow_requests": slowAttempts, "slow_planned_puts": slowAttempts, "reply_reads_after_handshake": 0,
+		"stream_receive_window": 0, "request_limit_bytes": limit,
+	}
+	var slow *slowSender
+	// On failure, diagnose before cleanup closes the raw socket. The writer
+	// must always be joined, including failed healthy requests or snapshots.
+	defer func() {
+		if resultErr != nil {
+			report["valid"] = false
+			report["failure"] = resultErr.Error()
+			file, err := captureGoroutines(*debugURL, *out, "failure")
+			if err != nil {
+				report["failure_goroutines_error"] = err.Error()
+			} else {
+				report["failure_goroutines"] = file
+			}
+		}
+		if slow != nil {
+			if !slow.closing.Load() {
+				report["sender_before_cleanup"] = slow.snapshot()
+			}
+			final, err := slow.closeAndWait(3 * time.Second)
+			recordSender(report, final)
+			if err != nil {
+				resultErr = errors.Join(resultErr, err)
+				report["valid"] = false
+				report["cleanup_error"] = err.Error()
+			}
+		}
+		b, err := json.MarshalIndent(report, "", "  ")
+		if err == nil {
+			err = os.WriteFile(*out, append(b, '\n'), 0o644)
+		}
+		resultErr = errors.Join(resultErr, err)
+	}()
+	ca, err := os.ReadFile(*certdir + "/ca.pem")
+	if err != nil {
+		return err
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(ca) {
+		return errors.New("bad CA")
+	}
+	cert, err := tls.LoadX509KeyPair(*certdir+"/client.pem", *certdir+"/client-key.pem")
+	if err != nil {
+		return err
+	}
+	cfg := &tls.Config{
+		RootCAs: pool, Certificates: []tls.Certificate{cert},
+		MinVersion: tls.VersionTLS13, MaxVersion: tls.VersionTLS13, NextProtos: []string{"h2"},
+	}
+	conn, err := grpc.NewClient(*endpoint, grpc.WithTransportCredentials(credentials.NewTLS(cfg)))
+	if err != nil {
+		return err
+	}
+	defer func() { _ = conn.Close() }()
+	kv := pb.NewKVClient(conn)
+	put := func(key, value []byte) (*pb.PutResponse, error) {
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		return kv.Put(ctx, &pb.PutRequest{Key: key, Value: value})
+	}
+	get := func(key []byte) (*pb.RangeResponse, error) {
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		return kv.Range(ctx, &pb.RangeRequest{Key: key})
+	}
+	snapshots := map[string]retainedSnapshot{}
+	retained := func(phase string) error {
+		client := &http.Client{Timeout: 15 * time.Second}
+		r, err := client.Get(*debugURL + "/debug/retained")
+		if err != nil {
+			return err
+		}
+		b, readErr := io.ReadAll(r.Body)
+		closeErr := r.Body.Close()
+		if err := errors.Join(readErr, closeErr); err != nil {
+			return err
+		}
+		if r.StatusCode != http.StatusOK {
+			return fmt.Errorf("retained: %s", r.Status)
+		}
+		var j retainedSnapshot
+		if err := json.Unmarshal(b, &j); err != nil {
+			return err
+		}
+		report[phase] = j
+		snapshots[phase] = j
+		if !j.ForcedGC {
+			return errors.New("retention snapshot did not force GC")
+		}
+		return validateAllocator(j.Allocator, mode)
+	}
+	key := []byte("/alloc50/large")
+	value := valueOfSize(limit)
+	n := limit
+	for raftSize(key, value[:n]) > limit {
+		n--
+	}
+	boundary := []map[string]any{}
+	for _, size := range []int{n - 1, n, n + 1, limit} {
+		response, err := put(key, value[:size])
+		expectedOK := size <= n
+		row := map[string]any{"payload_bytes": size, "internal_raft_request_bytes": raftSize(key, value[:size]), "expected_ok": expectedOK}
+		if err != nil {
+			row["error"] = err.Error()
+		}
+		if response != nil && response.Header != nil {
+			row["revision"] = response.Header.Revision
+		}
+		boundary = append(boundary, row)
+		report["boundary"] = boundary
+		if expectedOK {
+			if err != nil || response == nil || response.Header == nil {
+				return errors.Join(errors.New("below/equal boundary Put failed or missing header"), err)
+			}
+		} else if err == nil || !errors.Is(rpctypes.Error(err), rpctypes.ErrRequestTooLarge) {
+			return errors.Join(errors.New("above boundary should be request-too-large"), err)
+		}
+		r, err := get(key)
+		if err != nil || r == nil || len(r.Kvs) != 1 {
+			return errors.Join(errors.New("boundary Range failed or missing value"), err)
+		}
+		want := size
+		if !expectedOK {
+			want = n
+		}
+		if !bytes.Equal(r.Kvs[0].Value, value[:want]) {
+			return errors.New("large value corrupted or rejected Put mutated state")
+		}
+	}
+	report["accepted_payload_bytes"] = n
+	if err := retained("before_slow"); err != nil {
+		return err
+	}
+	slow, err = stalled(*endpoint, cfg, []byte("/alloc50/slow"))
+	if err != nil {
+		return err
+	}
+	started := time.Now()
+	var quotaAt time.Time
+	quotaSamples := []map[string]any{}
+	pollQuota := func() error {
+		if err := slow.check(); err != nil {
+			return err
+		}
+		if mode == 0 {
+			return nil
+		}
+		body, err := observation(*debugURL, "/debug/allocator", 3*time.Second)
+		if err != nil {
+			return err
+		}
+		var a map[string]uint64
+		if err := json.Unmarshal(body, &a); err != nil {
+			return err
+		}
+		if err := validateAllocator(a, mode); err != nil {
+			return err
+		}
+		now := time.Now()
+		quotaSamples = append(quotaSamples, map[string]any{"elapsed_s": now.Sub(started).Seconds(), "allocator": a})
+		report["quota_samples"] = quotaSamples
+		pinned := a["held_slots"] >= a["per_connection_slots"] && a["denied_count"] > snapshots["before_slow"].Allocator["denied_count"]
+		if quotaAt.IsZero() {
+			if now.Sub(started) > 5*time.Second {
+				return errors.New("managed quota/refusal not observed within five seconds")
+			}
+			if pinned {
+				quotaAt = now
+				report["quota_observed_elapsed_s"] = now.Sub(started).Seconds()
+			}
+		} else if !pinned {
+			return errors.New("managed quota was released before intentional close")
+		}
+		return nil
+	}
+	// Healthy work starts immediately, even if the single raw writer blocks.
+	healthyKey, healthy := []byte("/alloc50/healthy"), valueOfSize(1024)
+	successes := 0
+	var previous int64
+	healthyPut := func() error {
+		if err := slow.check(); err != nil {
+			return err
+		}
+		r, err := put(healthyKey, healthy)
+		if err != nil || r == nil || r.Header == nil || r.Header.Revision <= previous {
+			return errors.Join(errors.New("healthy Put while stalled failed or invalid revision"), err)
+		}
+		previous = r.Header.Revision
+		successes++
+		report["healthy_successes_while_stalled"] = successes
+		if successes%16 == 0 {
+			return pollQuota()
+		}
+		return nil
+	}
+	for phase := range 3 {
+		if phase > 0 && mode != 0 {
+			// Establish quota by five seconds, then sustain it for at least one
+			// second. Keep healthy Puts progressing throughout that hold.
+			for quotaAt.IsZero() {
+				if err := pollQuota(); err != nil {
+					return err
+				}
+				if err := healthyPut(); err != nil {
+					return err
+				}
+			}
+			until := quotaAt.Add(time.Duration(phase) * 500 * time.Millisecond)
+			for time.Now().Before(until) {
+				if err := pollQuota(); err != nil {
+					return err
+				}
+				if err := healthyPut(); err != nil {
+					return err
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		}
+		for range 512 {
+			if err := healthyPut(); err != nil {
+				return err
+			}
+		}
+		if err := pollQuota(); err != nil {
+			return err
+		}
+		if err := retained(fmt.Sprintf("slow_phase_%d", phase)); err != nil {
+			return err
+		}
+		report[fmt.Sprintf("sender_phase_%d", phase)] = slow.snapshot()
+	}
+	if mode == 0 {
+		for !slow.snapshot().AllDataSent {
+			if err := slow.check(); err != nil {
+				return err
+			}
+			if time.Since(started) > 5*time.Second {
+				return errors.New("baseline sender did not complete all planned Puts")
+			}
+			if err := healthyPut(); err != nil {
+				return err
+			}
+		}
+	} else {
+		if quotaAt.IsZero() || time.Since(quotaAt) < time.Second {
+			return errors.New("managed quota not sustained for one second")
+		}
+		report["quota_sustained_s"] = time.Since(quotaAt).Seconds()
+	}
+	if mode != 0 {
+		last := snapshots["slow_phase_2"].Allocator
+		prior := snapshots["slow_phase_1"].Allocator
+		if last["held_slots"] < last["per_connection_slots"] {
+			return fmt.Errorf("slow client did not pin its slot quota: %v", last)
+		}
+		if last["held_slots"] != prior["held_slots"] || last["held_bytes"] != prior["held_bytes"] {
+			return fmt.Errorf("managed retention did not stabilize: prior=%v after=%v", prior, last)
+		}
+		if last["denied_count"] <= snapshots["before_slow"].Allocator["denied_count"] {
+			return errors.New("slow workload did not exercise quota backpressure")
+		}
+		report["allocator_saturation_verified"] = true
+	}
+	report["healthy_successes_while_stalled"] = successes
+	report["healthy_last_revision"] = previous
+	// The slow connection never reads replies, so stream attempts and charged
+	// slot reservations cannot be presented as successful Puts. Its key starts
+	// absent and each committed overwrite increments Version exactly once.
+	slowKey := []byte("/alloc50/slow")
+	slowRange, err := get(slowKey)
+	if err != nil {
+		return errors.Join(errors.New("healthy Range of slow key failed"), err)
+	}
+	committed, err := slowCommittedPuts(slowRange, slowKey, valueOfSize(1024))
+	if err != nil {
+		return err
+	}
+	report["slow_committed_puts"] = committed
+	report["slow_range_header"] = slowRange.Header
+	report["slow_last_mod_revision"] = slowRange.Kvs[0].ModRevision
+	if err := slow.check(); err != nil {
+		return err
+	}
+	beforeClose := slow.snapshot()
+	report["sender_before_close"] = beforeClose
+	if !beforeClose.AllDataSent {
+		file, err := captureGoroutines(*debugURL, *out, "blocked-prefix")
+		if err != nil {
+			return err
+		}
+		report["blocked_prefix_goroutines"] = file
+	}
+	final, err := slow.closeAndWait(3 * time.Second)
+	recordSender(report, final)
+	if err != nil {
+		return err
+	}
+	if err := validateSender(final, committed, mode != 0); err != nil {
+		return err
+	}
+	report["sender_outcome_verified"] = true
+	time.Sleep(200 * time.Millisecond)
+	postClose, err := put(healthyKey, healthy)
+	if err != nil || postClose == nil || postClose.Header == nil || postClose.Header.Revision <= previous {
+		return errors.Join(errors.New("healthy Put after slow close failed or invalid revision"), err)
+	}
+	report["healthy_revision_after_close"] = postClose.Header.Revision
+	r, err := get(healthyKey)
+	if err != nil || r == nil || len(r.Kvs) != 1 || !bytes.Equal(r.Kvs[0].Value, healthy) {
+		return errors.Join(errors.New("healthy final Range failed or wrong value"), err)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	recovery := []retainedSnapshot{}
+	for {
+		if err := retained("after_slow_close"); err != nil {
+			return err
+		}
+		latest := snapshots["after_slow_close"]
+		recovery = append(recovery, latest)
+		report["recovery_samples"] = recovery
+		before := snapshots["before_slow"].Allocator
+		if mode == 0 || (latest.Allocator["held_slots"] <= before["held_slots"] && latest.Allocator["held_bytes"] <= before["held_bytes"]) {
+			break
+		}
+		if time.Now().After(deadline) {
+			return fmt.Errorf("managed slots not released after close: %v", latest.Allocator)
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	report["allocator_recovery_verified"] = mode != 0
+	report["valid"] = true
+	return nil
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
diff --git a/experiments/alloc50/cases/main_test.go b/experiments/alloc50/cases/main_test.go
new file mode 100644
index 0000000..de581ef
--- /dev/null
+++ b/experiments/alloc50/cases/main_test.go
@@ -0,0 +1,79 @@
+package main
+
+import (
+	"bytes"
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestInternalRaftBoundaryNotPayloadBoundary(t *testing.T) {
+	key := []byte("/alloc50/large")
+	value := make([]byte, limit)
+	n := limit
+	for raftSize(key, value[:n]) > limit {
+		n--
+	}
+	if n >= limit || raftSize(key, value[:n]) != limit || raftSize(key, value[:n+1]) != limit+1 {
+		t.Fatalf("bad boundary n=%d sizes=%d/%d", n, raftSize(key, value[:n]), raftSize(key, value[:n+1]))
+	}
+	request := &pb.PutRequest{Key: key, Value: value[:n]}
+	if proto.Size(request) >= limit {
+		t.Fatal("forgot InternalRaftRequest overhead")
+	}
+	wire, err := proto.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded := new(pb.PutRequest)
+	if err := proto.Unmarshal(wire, decoded); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(decoded.Value, request.Value) {
+		t.Fatal("boundary payload changed")
+	}
+}
+
+func TestSlowCommittedCountNotCapacity(t *testing.T) {
+	key, value := []byte("/alloc50/slow"), valueOfSize(1024)
+	for _, version := range []int64{32, 256, 4096} {
+		r := &pb.RangeResponse{
+			Header: &pb.ResponseHeader{Revision: 5000}, Count: 1,
+			Kvs: []*mvccpb.KeyValue{{Key: key, Value: value, Version: version}},
+		}
+		count, err := slowCommittedPuts(r, key, value)
+		if err != nil || count != version {
+			t.Fatalf("committed=%d want=%d err=%v", count, version, err)
+		}
+	}
+	for _, version := range []int64{0, 4097} {
+		r := &pb.RangeResponse{
+			Header: &pb.ResponseHeader{}, Count: 1,
+			Kvs: []*mvccpb.KeyValue{{Key: key, Value: value, Version: version}},
+		}
+		if _, err := slowCommittedPuts(r, key, value); err == nil {
+			t.Fatalf("invalid count %d accepted", version)
+		}
+	}
+	if _, err := slowCommittedPuts(nil, key, value); err == nil {
+		t.Fatal("missing Range accepted")
+	}
+}
+
+func TestSlowPutsFitAdvertisedCredit(t *testing.T) {
+	wire, err := proto.Marshal(&pb.PutRequest{Key: []byte("/alloc50/slow"), Value: valueOfSize(1024)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if 4096*(5+len(wire)) > 16<<20 {
+		t.Fatal("slow workload exceeds server connection credit")
+	}
+	if 5+len(wire) > 4<<20 {
+		t.Fatal("slow request exceeds server stream credit")
+	}
+	if bytes.Equal(valueOfSize(1024), make([]byte, 1024)) {
+		t.Fatal("value fixture is empty")
+	}
+}
diff --git a/experiments/alloc50/cases/observation.go b/experiments/alloc50/cases/observation.go
new file mode 100644
index 0000000..4cd9d54
--- /dev/null
+++ b/experiments/alloc50/cases/observation.go
@@ -0,0 +1,47 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"time"
+)
+
+func observation(debugURL, path string, timeout time.Duration) ([]byte, error) {
+	client := &http.Client{Timeout: timeout}
+	r, err := client.Get(debugURL + path)
+	if err != nil {
+		return nil, err
+	}
+	b, readErr := io.ReadAll(r.Body)
+	closeErr := r.Body.Close()
+	if err := errors.Join(readErr, closeErr); err != nil {
+		return nil, err
+	}
+	if r.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("observation %s: %s", path, r.Status)
+	}
+	return b, nil
+}
+
+func captureGoroutines(debugURL, out, phase string) (string, error) {
+	b, err := observation(debugURL, "/debug/goroutines", 3*time.Second)
+	if err != nil {
+		return "", err
+	}
+	file := out + "." + phase + ".goroutines.txt"
+	if err := os.WriteFile(file, b, 0o644); err != nil {
+		return "", err
+	}
+	return file, nil
+}
+
+func recordSender(report map[string]any, j senderSnapshot) {
+	report["slow_sender"] = j
+	report["slow_attempted_puts"] = j.Attempted
+	report["slow_sent_headers"] = j.Headers
+	report["slow_sent_data"] = j.Data
+	report["slow_data_bytes"] = j.DataBytes
+}
diff --git a/experiments/alloc50/cases/sender.go b/experiments/alloc50/cases/sender.go
new file mode 100644
index 0000000..c2da770
--- /dev/null
+++ b/experiments/alloc50/cases/sender.go
@@ -0,0 +1,252 @@
+package main
+
+import (
+	"bytes"
+	"crypto/tls"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"sync/atomic"
+	"time"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"golang.org/x/net/http2"
+	"golang.org/x/net/http2/hpack"
+	"google.golang.org/protobuf/proto"
+)
+
+type senderSnapshot struct {
+	Planned            uint64 `json:"planned_puts"`
+	Attempted          uint64 `json:"attempted_puts"`
+	Headers            uint64 `json:"sent_headers"`
+	Data               uint64 `json:"completed_data"`
+	DataBytes          uint64 `json:"completed_data_bytes"`
+	MessageBytes       uint64 `json:"message_bytes"`
+	Finished           bool   `json:"finished"`
+	AllDataSent        bool   `json:"all_data_sent"`
+	IntentionalClose   bool   `json:"intentional_close"`
+	Error              string `json:"error"`
+	ErrorBeforeClose   bool   `json:"error_before_close"`
+	ExpectedCloseError bool   `json:"expected_close_error"`
+	Stage              string `json:"stage"`
+}
+
+type slowSender struct {
+	conn                                         net.Conn
+	fr                                           *http2.Framer
+	header, data                                 []byte
+	planned                                      uint64
+	attempted, headers, completedData, dataBytes atomic.Uint64
+	closing                                      atomic.Bool
+	done                                         chan struct{}
+	// Published once before close(done); readers access only after that fence.
+	err         error
+	beforeClose bool
+	stage       string
+}
+
+func (s *slowSender) start(timeout time.Duration) error {
+	if err := s.conn.SetWriteDeadline(time.Now().Add(timeout)); err != nil {
+		return err
+	}
+	s.done = make(chan struct{})
+	go func() {
+		defer close(s.done)
+		for i := range s.planned {
+			if s.closing.Load() {
+				s.err = net.ErrClosed
+				return
+			}
+			s.attempted.Add(1)
+			id := uint32(1 + 2*i)
+			s.stage = "headers"
+			if err := s.fr.WriteHeaders(http2.HeadersFrameParam{StreamID: id, BlockFragment: s.header, EndHeaders: true}); err != nil {
+				s.err, s.beforeClose = err, !s.closing.Load()
+				return
+			}
+			s.headers.Add(1)
+			s.stage = "data"
+			if err := s.fr.WriteData(id, true, s.data); err != nil {
+				s.err, s.beforeClose = err, !s.closing.Load()
+				return
+			}
+			s.completedData.Add(1)
+			s.dataBytes.Add(uint64(len(s.data)))
+		}
+		s.stage = "complete"
+	}()
+	return nil
+}
+
+func (s *slowSender) snapshot() senderSnapshot {
+	j := senderSnapshot{
+		Planned: s.planned, Attempted: s.attempted.Load(), Headers: s.headers.Load(),
+		Data: s.completedData.Load(), DataBytes: s.dataBytes.Load(), MessageBytes: uint64(len(s.data)), IntentionalClose: s.closing.Load(),
+	}
+	select {
+	case <-s.done:
+		j.Finished, j.Stage = true, s.stage
+		j.ErrorBeforeClose = s.beforeClose
+		if s.err != nil {
+			j.Error = s.err.Error()
+			j.ExpectedCloseError = !s.beforeClose && s.closing.Load() && (errors.Is(s.err, net.ErrClosed) || errors.Is(s.err, io.ErrClosedPipe))
+		}
+	default:
+		j.Stage = "sending"
+	}
+	j.AllDataSent = j.Finished && j.Data == j.Planned && j.Error == ""
+	return j
+}
+
+func (s *slowSender) check() error {
+	select {
+	case <-s.done:
+		if s.err != nil {
+			return fmt.Errorf("raw sender failed before intentional close: %w", s.err)
+		}
+	default:
+	}
+	return nil
+}
+
+func (s *slowSender) closeAndWait(timeout time.Duration) (senderSnapshot, error) {
+	s.closing.Store(true)
+	closeErr := s.conn.Close()
+	if errors.Is(closeErr, net.ErrClosed) || errors.Is(closeErr, io.ErrClosedPipe) {
+		closeErr = nil
+	}
+	select {
+	case <-s.done:
+		j := s.snapshot()
+		if j.Error != "" && !j.ExpectedCloseError {
+			return j, errors.Join(closeErr, fmt.Errorf("raw sender error: %w", s.err))
+		}
+		return j, closeErr
+	case <-time.After(timeout):
+		return s.snapshot(), errors.Join(closeErr, errors.New("raw sender did not terminate after connection close"))
+	}
+}
+
+func validateSender(j senderSnapshot, committed int64, managed bool) error {
+	if !j.Finished || j.Planned == 0 || j.Attempted > j.Planned || j.Headers > j.Attempted || j.Data > j.Headers ||
+		j.Attempted-j.Headers > 1 || j.Headers-j.Data > 1 || j.DataBytes != j.Data*j.MessageBytes {
+		return fmt.Errorf("inconsistent raw sender counts: %+v", j)
+	}
+	if committed < 1 || uint64(committed) > j.Planned || uint64(committed) > j.Data+1 {
+		return fmt.Errorf("committed=%d exceeds complete DATA plus last in-progress frame: %+v", committed, j)
+	}
+	if j.ErrorBeforeClose || (j.Error != "" && !j.ExpectedCloseError) {
+		return fmt.Errorf("unexpected sender error: %+v", j)
+	}
+	if !managed && (!j.AllDataSent || j.Error != "") {
+		return fmt.Errorf("baseline did not send every planned Put: %+v", j)
+	}
+	if j.Data < j.Planned && !j.ExpectedCloseError {
+		return fmt.Errorf("partial sender without intentional close evidence: %+v", j)
+	}
+	return nil
+}
+
+// Only handshake reads occur here. Clear its deadline before launching exactly
+// one bounded sender; healthy work must not wait for the raw prefix to finish.
+func stalled(endpoint string, cfg *tls.Config, key []byte) (*slowSender, error) {
+	tcp, err := net.DialTimeout("tcp", endpoint, 5*time.Second)
+	if err != nil {
+		return nil, err
+	}
+	fail := func(e error) (*slowSender, error) { _ = tcp.Close(); return nil, e }
+	if t, ok := tcp.(*net.TCPConn); ok {
+		if err := t.SetReadBuffer(4096); err != nil {
+			return fail(err)
+		}
+	}
+	rawCFG := cfg.Clone()
+	host, _, err := net.SplitHostPort(endpoint)
+	if err != nil {
+		return fail(err)
+	}
+	rawCFG.ServerName = host
+	tc := tls.Client(tcp, rawCFG)
+	if err := tc.SetDeadline(time.Now().Add(10 * time.Second)); err != nil {
+		return fail(err)
+	}
+	if err := tc.Handshake(); err != nil {
+		return fail(err)
+	}
+	if tc.ConnectionState().NegotiatedProtocol != "h2" {
+		return fail(errors.New("missing h2 ALPN"))
+	}
+	if _, err := io.WriteString(tc, http2.ClientPreface); err != nil {
+		return fail(err)
+	}
+	fr := http2.NewFramer(tc, tc)
+	if err := fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 0}); err != nil {
+		return fail(err)
+	}
+	gotSettings, gotAck := false, false
+	credit, streamWindow := 65535, 65535
+	for !gotSettings || !gotAck || credit == 65535 {
+		frame, err := fr.ReadFrame()
+		if err != nil {
+			return fail(err)
+		}
+		if s, ok := frame.(*http2.SettingsFrame); ok {
+			if s.IsAck() {
+				gotAck = true
+			} else {
+				gotSettings = true
+				if err := s.ForeachSetting(func(setting http2.Setting) error {
+					if setting.ID == http2.SettingInitialWindowSize {
+						streamWindow = int(setting.Val)
+					}
+					return nil
+				}); err != nil {
+					return fail(err)
+				}
+				if err := fr.WriteSettingsAck(); err != nil {
+					return fail(err)
+				}
+			}
+		}
+		if w, ok := frame.(*http2.WindowUpdateFrame); ok && w.StreamID == 0 {
+			credit += int(w.Increment)
+		}
+	}
+	request, err := proto.Marshal(&pb.PutRequest{Key: key, Value: valueOfSize(1024)})
+	if err != nil {
+		return fail(err)
+	}
+	data := make([]byte, 5+len(request))
+	binary.BigEndian.PutUint32(data[1:5], uint32(len(request)))
+	copy(data[5:], request)
+	if len(data) > streamWindow || slowAttempts*len(data) > credit {
+		return fail(fmt.Errorf("slow workload exceeds advertised credit: stream=%d connection=%d bytes=%d", streamWindow, credit, slowAttempts*len(data)))
+	}
+	var header bytes.Buffer
+	enc := hpack.NewEncoder(&header)
+	enc.SetMaxDynamicTableSize(0)
+	for _, field := range []hpack.HeaderField{
+		{Name: ":method", Value: "POST"},
+		{Name: ":scheme", Value: "https"},
+		{Name: ":authority", Value: endpoint},
+		{Name: ":path", Value: "/etcdserverpb.KV/Put"},
+		{Name: "content-type", Value: "application/grpc"},
+		{Name: "te", Value: "trailers"},
+	} {
+		if err := enc.WriteField(field); err != nil {
+			return fail(err)
+		}
+	}
+	if err := tc.SetDeadline(time.Time{}); err != nil {
+		return fail(err)
+	}
+	// Close the underlying TCP socket, not TLS Close (which can block while
+	// sending close_notify). Framer I/O still runs through the TLS connection.
+	s := &slowSender{conn: tcp, fr: fr, header: header.Bytes(), data: data, planned: slowAttempts}
+	if err := s.start(20 * time.Second); err != nil {
+		return fail(err)
+	}
+	return s, nil
+}
diff --git a/experiments/alloc50/cases/sender_test.go b/experiments/alloc50/cases/sender_test.go
new file mode 100644
index 0000000..08582fd
--- /dev/null
+++ b/experiments/alloc50/cases/sender_test.go
@@ -0,0 +1,142 @@
+package main
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+func fixtureSender(t *testing.T, conn net.Conn, planned uint64, timeout time.Duration) *slowSender {
+	t.Helper()
+	s := &slowSender{conn: conn, fr: http2.NewFramer(conn, conn), header: []byte{0x83}, data: []byte{0, 0, 0, 0, 1, 'v'}, planned: planned}
+	if err := s.start(timeout); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _, _ = s.closeAndWait(time.Second) })
+	return s
+}
+
+func TestSenderCompleteCounts(t *testing.T) {
+	client, server := net.Pipe()
+	defer func() { _ = server.Close() }()
+	read := make(chan error, 1)
+	go func() {
+		fr := http2.NewFramer(server, server)
+		for range 6 {
+			if _, err := fr.ReadFrame(); err != nil {
+				read <- err
+				return
+			}
+		}
+		read <- nil
+	}()
+	s := fixtureSender(t, client, 3, time.Second)
+	select {
+	case <-s.done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("sender did not finish")
+	}
+	if err := <-read; err != nil {
+		t.Fatal(err)
+	}
+	j, err := s.closeAndWait(time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if j.Attempted != 3 || j.Headers != 3 || j.Data != 3 || j.DataBytes != 18 || !j.AllDataSent {
+		t.Fatalf("bad counters: %+v", j)
+	}
+	if err := validateSender(j, 3, false); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestSenderBlockedPrefixJoinsOnIntentionalClose(t *testing.T) {
+	client, server := net.Pipe()
+	defer func() { _ = server.Close() }()
+	read := make(chan error, 1)
+	go func() {
+		fr := http2.NewFramer(server, server)
+		for range 2 {
+			if _, err := fr.ReadFrame(); err != nil {
+				read <- err
+				return
+			}
+		}
+		// Stop reading with the next HEADERS in progress.
+		read <- nil
+	}()
+	s := fixtureSender(t, client, 4, time.Second)
+	if err := <-read; err != nil {
+		t.Fatal(err)
+	}
+	until := time.Now().Add(time.Second)
+	for s.attempted.Load() < 2 && time.Now().Before(until) {
+		time.Sleep(time.Millisecond)
+	}
+	j, err := s.closeAndWait(time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if j.Attempted != 2 || j.Headers != 1 || j.Data != 1 || j.DataBytes != 6 || !j.ExpectedCloseError || j.ErrorBeforeClose {
+		t.Fatalf("bad prefix: %+v", j)
+	}
+	if err := validateSender(j, 1, true); err != nil {
+		t.Fatal(err)
+	}
+	if err := validateSender(j, 2, true); err != nil {
+		t.Fatal("last in-progress DATA allowance rejected:", err)
+	}
+	if err := validateSender(j, 3, true); err == nil {
+		t.Fatal("commits beyond DATA+1 accepted")
+	}
+	if err := validateSender(j, 1, false); err == nil {
+		t.Fatal("baseline prefix accepted")
+	}
+}
+
+func TestSenderDeadlineBeforeCloseIsFailure(t *testing.T) {
+	client, server := net.Pipe()
+	defer func() { _ = server.Close() }()
+	s := fixtureSender(t, client, 4, 20*time.Millisecond)
+	select {
+	case <-s.done:
+	case <-time.After(time.Second):
+		t.Fatal("deadline did not stop blocked writer")
+	}
+	if err := s.check(); err == nil {
+		t.Fatal("premature timeout accepted")
+	}
+	j, err := s.closeAndWait(time.Second)
+	if err == nil || !j.ErrorBeforeClose || j.ExpectedCloseError {
+		t.Fatalf("timeout masked by cleanup: %+v err=%v", j, err)
+	}
+	if err := validateSender(j, 1, true); err == nil {
+		t.Fatal("timeout outcome accepted")
+	}
+}
+
+func TestSenderCounterConsistency(t *testing.T) {
+	j := senderSnapshot{Planned: 4096, Attempted: 4096, Headers: 4096, Data: 4096, DataBytes: 24576, MessageBytes: 6, Finished: true, AllDataSent: true, IntentionalClose: true}
+	if err := validateSender(j, 256, true); err != nil {
+		t.Fatal(err)
+	}
+	broken := j
+	broken.Headers = 4097
+	if err := validateSender(broken, 256, true); err == nil {
+		t.Fatal("headers beyond attempts accepted")
+	}
+	broken = j
+	broken.DataBytes--
+	if err := validateSender(broken, 256, true); err == nil {
+		t.Fatal("inconsistent bytes accepted")
+	}
+	broken = j
+	broken.Error = "premature reset"
+	broken.ErrorBeforeClose = true
+	if err := validateSender(broken, 256, true); err == nil {
+		t.Fatal("premature error accepted")
+	}
+}
