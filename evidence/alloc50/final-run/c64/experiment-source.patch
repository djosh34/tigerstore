index 0000000..c899b4c
--- /dev/null
+++ b/experiments/bench75/load/main.go
@@ -0,0 +1,289 @@
+// A closed-loop, direct etcd protobuf client used unchanged for both servers.
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"log"
+	"math"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials"
+)
+
+type cpu struct {
+	PID          int
+	Ticks, Start uint64
+}
+
+func sample(pid int) (cpu, error) {
+	b, e := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if e != nil {
+		return cpu{}, e
+	}
+	pos := strings.LastIndex(string(b), ")")
+	if pos < 0 {
+		return cpu{}, errors.New("bad proc stat")
+	}
+	s := strings.Fields(string(b[pos+1:]))
+	u, e := strconv.ParseUint(s[11], 10, 64)
+	if e != nil {
+		return cpu{}, e
+	}
+	k, e := strconv.ParseUint(s[12], 10, 64)
+	if e != nil {
+		return cpu{}, e
+	}
+	st, e := strconv.ParseUint(s[19], 10, 64)
+	return cpu{pid, u + k, st}, e
+}
+
+func run() error {
+	endpoint := flag.String("endpoint", "127.0.0.1:2379", "leader endpoint")
+	certdir := flag.String("certdir", "", "cert directory")
+	op := flag.String("op", "put", "put or range")
+	total := flag.Uint64("total", 60000, "operations, zero for duration")
+	duration := flag.Duration("duration", 0, "arrival duration, drain included in elapsed")
+	workers := flag.Int("workers", 256, "closed-loop concurrency")
+	conns := flag.Int("conns", 16, "connections")
+	pidstr := flag.String("pids", "", "leader,follower1,follower2")
+	hz := flag.Float64("hz", 100, "getconf CLK_TCK")
+	out := flag.String("out", "", "json output")
+	metricsURL := flag.String("metrics-url", "", "leader runtime metrics or Prometheus endpoint")
+	metricsKind := flag.String("metrics-kind", "runtime", "runtime or etcd")
+	flag.Parse()
+	if (*op != "put" && *op != "range") || *workers < 1 || *conns < 1 || (*total == 0 && *duration <= 0) {
+		return errors.New("invalid flags")
+	}
+	ca, e := os.ReadFile(*certdir + "/ca.pem")
+	if e != nil {
+		return e
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(ca) {
+		return errors.New("bad CA")
+	}
+	cert, e := tls.LoadX509KeyPair(*certdir+"/client.pem", *certdir+"/client-key.pem")
+	if e != nil {
+		return e
+	}
+	cfg := &tls.Config{RootCAs: pool, Certificates: []tls.Certificate{cert}, MinVersion: tls.VersionTLS13, MaxVersion: tls.VersionTLS13}
+	clients := make([]pb.KVClient, *conns)
+	for i := range clients {
+		c, e := grpc.NewClient(*endpoint, grpc.WithTransportCredentials(credentials.NewTLS(cfg.Clone())))
+		if e != nil {
+			return e
+		}
+		defer func() {
+			if err := c.Close(); err != nil {
+				log.Printf("close client: %v", err)
+			}
+		}()
+		clients[i] = pb.NewKVClient(c)
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		_, e = clients[i].Range(ctx, &pb.RangeRequest{Key: []byte("/pre50-probe")})
+		cancel()
+		if e != nil {
+			return e
+		}
+	}
+	const keyspace = 4096
+	keys := make([][]byte, keyspace)
+	values := make([][]byte, keyspace)
+	for i := range keyspace {
+		keys[i] = []byte(fmt.Sprintf("/registry/pods/ns-%03d/pod-%08d", i%64, i))
+		values[i] = make([]byte, 1024)
+		for j := range 32 {
+			s := sha256.Sum256([]byte(fmt.Sprintf("pre50-independent-%d-%d", i, j)))
+			copy(values[i][j*32:], s[:])
+		}
+	}
+	probe := func() (*pb.RangeResponse, error) {
+		ctx, c := context.WithTimeout(context.Background(), 10*time.Second)
+		defer c()
+		return clients[0].Range(ctx, &pb.RangeRequest{Key: keys[0]})
+	}
+	before, e := probe()
+	if e != nil {
+		return e
+	}
+	pids := []int{}
+	if *pidstr != "" {
+		for p := range strings.SplitSeq(*pidstr, ",") {
+			id, e := strconv.Atoi(p)
+			if e != nil {
+				return e
+			}
+			pids = append(pids, id)
+		}
+	}
+	pids = append(pids, os.Getpid())
+	pre := make([]cpu, len(pids))
+	post := make([]cpu, len(pids))
+	var next atomic.Uint64
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	latencies := make([][]int64, *workers)
+	errs := make([]map[string]int, *workers)
+	terms := make([]map[uint64]int, *workers)
+	var deadline time.Time
+	for w := range *workers {
+		wg.Go(func() {
+			<-start
+			local := make([]int64, 0, 1024)
+			em := map[string]int{}
+			tm := map[uint64]int{}
+			for {
+				i := next.Add(1) - 1
+				if (*total > 0 && i >= *total) || (!deadline.IsZero() && !time.Now().Before(deadline)) {
+					break
+				}
+				k := int((i * 2654435761) % keyspace)
+				t := time.Now()
+				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+				var err error
+				var h *pb.ResponseHeader
+				if *op == "put" {
+					var r *pb.PutResponse
+					r, err = clients[w%*conns].Put(ctx, &pb.PutRequest{Key: keys[k], Value: values[k]})
+					if r != nil {
+						h = r.Header
+					}
+				} else {
+					var r *pb.RangeResponse
+					r, err = clients[w%*conns].Range(ctx, &pb.RangeRequest{Key: keys[k]})
+					if r != nil {
+						h = r.Header
+						if err == nil && (r.Count != 1 || len(r.Kvs) != 1 || !bytes.Equal(r.Kvs[0].Key, keys[k]) || !bytes.Equal(r.Kvs[0].Value, values[k])) {
+							err = errors.New("invalid range result")
+						}
+					}
+				}
+				cancel()
+				dt := time.Since(t).Nanoseconds()
+				if err == nil && (h == nil || h.Revision < 1) {
+					err = errors.New("invalid header")
+				}
+				if err != nil {
+					em[err.Error()]++
+				} else {
+					local = append(local, dt)
+					tm[h.RaftTerm]++
+				}
+			}
+			latencies[w] = local
+			errs[w] = em
+			terms[w] = tm
+		})
+	}
+	var heapBefore, heapAfter heapSnapshot
+	if *metricsURL != "" {
+		heapBefore, e = sampleHeap(*metricsURL, *metricsKind)
+		if e != nil {
+			return e
+		}
+	}
+	for i, p := range pids {
+		pre[i], e = sample(p)
+		if e != nil {
+			return e
+		}
+	}
+	t := time.Now()
+	if *duration > 0 {
+		deadline = t.Add(*duration)
+	}
+	close(start)
+	wg.Wait()
+	elapsed := time.Since(t).Seconds()
+	for i, p := range pids {
+		post[i], e = sample(p)
+		if e != nil {
+			return e
+		}
+		if pre[i].Start != post[i].Start {
+			return errors.New("process restarted")
+		}
+	}
+	if *metricsURL != "" {
+		heapAfter, e = sampleHeap(*metricsURL, *metricsKind)
+		if e != nil {
+			return e
+		}
+	}
+	after, e := probe()
+	if e != nil {
+		return e
+	}
+	all := []int64{}
+	em := map[string]int{}
+	tm := map[uint64]int{}
+	for i := range *workers {
+		all = append(all, latencies[i]...)
+		for k, n := range errs[i] {
+			em[k] += n
+		}
+		for k, n := range terms[i] {
+			tm[k] += n
+		}
+	}
+	if len(all) == 0 {
+		return errors.New("no successes")
+	}
+	slices.Sort(all)
+	pct := func(p float64) float64 { return float64(all[int(math.Ceil(p*float64(len(all))))-1]) / 1e6 }
+	sum := float64(0)
+	for _, v := range all {
+		sum += float64(v)
+	}
+	cpus := make([]float64, len(pids))
+	occup := make([]float64, len(pids))
+	for i := range pids {
+		secs := float64(post[i].Ticks-pre[i].Ticks) / *hz
+		cpus[i] = secs * 1e6 / float64(len(all))
+		occup[i] = secs / elapsed
+	}
+	delta := after.Header.Revision - before.Header.Revision
+	valid := len(em) == 0 && len(tm) == 1 && (*total == 0 || uint64(len(all)) == *total) && ((*op == "put" && delta == int64(len(all))) || (*op == "range" && delta == 0))
+	result := map[string]any{"valid": valid, "op": *op, "successes": len(all), "errors": em, "terms": tm, "elapsed_s": elapsed, "ops_s": float64(len(all)) / elapsed, "mean_ms": sum / float64(len(all)) / 1e6, "p50_ms": pct(.5), "p90_ms": pct(.9), "p99_ms": pct(.99), "p999_ms": pct(.999), "max_ms": float64(all[len(all)-1]) / 1e6, "cpu_us_op": cpus, "occupied_cores": occup, "cpu_before": pre, "cpu_after": post, "revision_before": before.Header.Revision, "revision_after": after.Header.Revision, "workers": *workers, "conns": *conns, "keyspace": keyspace, "value_bytes": 1024, "clock_hz": *hz, "start_utc": t.UTC().Format(time.RFC3339Nano)}
+	if *metricsURL != "" {
+		delta, err := heapDelta(heapBefore, heapAfter, len(all))
+		if err != nil {
+			return err
+		}
+		result["leader_heap"] = delta
+	}
+	b, e := json.MarshalIndent(result, "", "  ")
+	if e != nil {
+		return e
+	}
+	if e = os.WriteFile(*out, append(b, '\n'), 0o644); e != nil {
+		return e
+	}
+	if !valid {
+		return errors.New("invalid measurement; see JSON")
+	}
+	return nil
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
diff --git a/experiments/bench75/load/metrics.go b/experiments/bench75/load/metrics.go
new file mode 100644
index 0000000..c9a84d3
--- /dev/null
+++ b/experiments/bench75/load/metrics.go
@@ -0,0 +1,103 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// These counters include all leader-process allocations, not only RPC handlers.
+type heapSnapshot struct {
+	Objects   float64            `json:"allocated_objects"`
+	Bytes     float64            `json:"allocated_bytes"`
+	HeapBytes float64            `json:"heap_object_bytes"`
+	GCCPU     float64            `json:"gc_cpu_seconds"`
+	BusyCPU   float64            `json:"runtime_nonidle_cpu_seconds"`
+	HasGCCPU  bool               `json:"has_gc_cpu"`
+	Raw       map[string]float64 `json:"raw"`
+}
+
+func parseHeap(b []byte, kind string) (heapSnapshot, error) {
+	m := map[string]float64{}
+	var objects, allocated, heap string
+	switch kind {
+	case "runtime":
+		if err := json.Unmarshal(b, &m); err != nil {
+			return heapSnapshot{}, err
+		}
+		objects, allocated, heap = "/gc/heap/allocs:objects", "/gc/heap/allocs:bytes", "/memory/classes/heap/objects:bytes"
+	case "etcd":
+		for line := range strings.SplitSeq(string(b), "\n") {
+			f := strings.Fields(line)
+			if len(f) == 2 && strings.HasPrefix(f[0], "go_memstats_") {
+				v, err := strconv.ParseFloat(f[1], 64)
+				if err != nil {
+					return heapSnapshot{}, err
+				}
+				m[f[0]] = v
+			}
+		}
+		objects, allocated, heap = "go_memstats_mallocs_total", "go_memstats_alloc_bytes_total", "go_memstats_heap_alloc_bytes"
+	default:
+		return heapSnapshot{}, errors.New("unknown metrics kind")
+	}
+	for _, k := range []string{objects, allocated, heap} {
+		if _, ok := m[k]; !ok {
+			return heapSnapshot{}, fmt.Errorf("missing heap metric %s", k)
+		}
+	}
+	s := heapSnapshot{Objects: m[objects], Bytes: m[allocated], HeapBytes: m[heap], Raw: m}
+	gc, hasGC := m["/cpu/classes/gc/total:cpu-seconds"]
+	total, hasTotal := m["/cpu/classes/total:cpu-seconds"]
+	idle, hasIdle := m["/cpu/classes/idle:cpu-seconds"]
+	if hasGC && hasTotal && hasIdle {
+		s.HasGCCPU, s.GCCPU, s.BusyCPU = true, gc, total-idle
+	}
+	return s, nil
+}
+
+func sampleHeap(url, kind string) (heapSnapshot, error) {
+	client := &http.Client{Timeout: 10 * time.Second}
+	r, err := client.Get(url)
+	if err != nil {
+		return heapSnapshot{}, err
+	}
+	b, readErr := io.ReadAll(r.Body)
+	closeErr := r.Body.Close()
+	if err := errors.Join(readErr, closeErr); err != nil {
+		return heapSnapshot{}, err
+	}
+	if r.StatusCode != http.StatusOK {
+		return heapSnapshot{}, fmt.Errorf("metrics returned %s", r.Status)
+	}
+	return parseHeap(b, kind)
+}
+
+func heapDelta(before, after heapSnapshot, n int) (map[string]any, error) {
+	if n < 1 || after.Objects < before.Objects || after.Bytes < before.Bytes {
+		return nil, errors.New("invalid allocation delta")
+	}
+	result := map[string]any{
+		"objects_per_put":  (after.Objects - before.Objects) / float64(n),
+		"bytes_per_put":    (after.Bytes - before.Bytes) / float64(n),
+		"heap_bytes_after": after.HeapBytes,
+		"before":           before,
+		"after":            after,
+	}
+	if before.HasGCCPU && after.HasGCCPU {
+		gc, busy := after.GCCPU-before.GCCPU, after.BusyCPU-before.BusyCPU
+		if gc < 0 || busy <= 0 {
+			return nil, errors.New("invalid GC CPU delta")
+		}
+		result["gc_cpu_share"] = gc / busy
+		result["gc_cpu_us_per_put"] = gc * 1e6 / float64(n)
+	} else {
+		result["gc_cpu_share"] = nil
+	}
+	return result, nil
+}
diff --git a/experiments/bench75/load/metrics_test.go b/experiments/bench75/load/metrics_test.go
new file mode 100644
index 0000000..5662d01
--- /dev/null
+++ b/experiments/bench75/load/metrics_test.go
@@ -0,0 +1,56 @@
+package main
+
+import (
+	"math"
+	"testing"
+)
+
+func TestHeapMetrics(t *testing.T) {
+	cases := []struct {
+		kind, input string
+		gc          bool
+	}{
+		{"runtime", `{"/gc/heap/allocs:objects":100,"/gc/heap/allocs:bytes":2048,"/memory/classes/heap/objects:bytes":1024,"/cpu/classes/gc/total:cpu-seconds":2,"/cpu/classes/total:cpu-seconds":20,"/cpu/classes/idle:cpu-seconds":5}`, true},
+		{"etcd", "# HELP comment\ngo_memstats_mallocs_total 100\ngo_memstats_alloc_bytes_total 2048\ngo_memstats_heap_alloc_bytes 1024\n", false},
+	}
+	for _, c := range cases {
+		t.Run(c.kind, func(t *testing.T) {
+			before, err := parseHeap([]byte(c.input), c.kind)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if before.Objects != 100 || before.Bytes != 2048 || before.HeapBytes != 1024 || before.HasGCCPU != c.gc {
+				t.Fatalf("bad snapshot: %+v", before)
+			}
+			after := before
+			after.Objects += 100
+			after.Bytes += 2048
+			after.GCCPU += 1
+			after.BusyCPU += 10
+			delta, err := heapDelta(before, after, 10)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if delta["objects_per_put"] != float64(10) || delta["bytes_per_put"] != 204.8 {
+				t.Fatalf("bad delta: %+v", delta)
+			}
+			if c.gc && math.Abs(delta["gc_cpu_share"].(float64)-.1) > 1e-12 {
+				t.Fatalf("bad GC share: %+v", delta)
+			}
+			if !c.gc && delta["gc_cpu_share"] != nil {
+				t.Fatal("must not report pause time as GC CPU")
+			}
+		})
+	}
+}
+
+func TestBadHeapMetrics(t *testing.T) {
+	for _, kind := range []string{"runtime", "etcd", "unknown"} {
+		if _, err := parseHeap([]byte("{}"), kind); err == nil {
+			t.Fatalf("accepted missing metrics for %s", kind)
+		}
+	}
+	if _, err := heapDelta(heapSnapshot{Objects: 2}, heapSnapshot{Objects: 1}, 10); err == nil {
+		t.Fatal("accepted decreasing counter")
+	}
+}
