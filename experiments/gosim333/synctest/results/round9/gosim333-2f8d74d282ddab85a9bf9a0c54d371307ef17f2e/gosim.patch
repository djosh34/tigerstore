@@ -0,0 +1,9 @@
+package gosimruntime
+
+// MissingHook constructs all fail-closed porting-stub panic messages.
+// Generated bodies use panic(MissingHook(name)) so the compiler knows they terminate.
+func MissingHook(name string) string { return "gosim: missing hook " + name }
+
+func AddressOf[T any](v T) *T { return &v }
+
+func NativeMapForABI[K comparable, V any]() any { var m map[K]V; return m }
