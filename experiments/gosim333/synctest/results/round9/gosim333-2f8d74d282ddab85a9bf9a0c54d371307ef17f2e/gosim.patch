+package go123
+
+import "github.com/jellevandenhooff/gosim/gosimruntime"
+
+// Go 1.27.2 src/internal/sync/mutex.go:105 and runtime.go:35-38 moved the
+// spin decision from sync. Reuse pinned gosim's sync.go:47-50 (never host-spin).
+func InternalSync_runtime_canSpin(i int) bool {
+ gosimruntime.Port333Reached("internal/sync.runtime_canSpin")
+ return Sync_runtime_canSpin(i)
+}
+
+// Moved mutex starvation clock: same simulated clock as the old sync hook
+// (pinned gosim internal/hooks/go123/sync.go:41-43).
+func InternalSync_runtime_nanotime() int64 {
+ gosimruntime.Port333Reached("internal/sync.runtime_nanotime")
+ return Sync_runtime_nanotime()
+}
+
+// Go 1.27.2 internal/sync/runtime.go:20-21, mutex.go:150; same signature as
+// pinned gosim's internal/hooks/go123/sync.go:15-17.
+func InternalSync_runtime_SemacquireMutex(addr *uint32, lifo bool, skipframes int) {
+ gosimruntime.Port333Reached("internal/sync.runtime_SemacquireMutex")
+ Sync_runtime_SemacquireMutex(addr, lifo, skipframes)
+}
+
+// Go 1.27.2 internal/sync/runtime.go:23-32; old gosim sync.go:11-13.
+func InternalSync_runtime_Semrelease(addr *uint32, handoff bool, skipframes int) {
+ gosimruntime.Port333Reached("internal/sync.runtime_Semrelease")
+ Sync_runtime_Semrelease(addr, handoff, skipframes)
+}
diff --git a/internal/hooks/go123/synctest333.go b/internal/hooks/go123/synctest333.go
new file mode 100644
index 0000000..f75255d
--- /dev/null
+++ b/internal/hooks/go123/synctest333.go
@@ -0,0 +1,36 @@
+package go123
+
+import (
+ "unsafe"
+ "github.com/jellevandenhooff/gosim/internal/testing"
+)
+
+// EXPERIMENT ONLY: one machine-wide bubble, using gosim's already virtual clock.
+// NOT Go synctest semantics: no per-goroutine membership, nested-bubble rejection,
+// bubble lifetime join, durable-block detection, acquire/release liveness, isolated
+// clocks, foreign-bubble detection, or special testing.T cleanup/context rules.
+// Wait remains the generated missing-hook panic. Run may return with goroutines
+// alive. This adapter only exposes deeper hooks; it is not a replay correctness port.
+var synctest333Active bool
+var synctest333Associations = map[unsafe.Pointer]bool{}
+
+func InternalSynctest_Run(f func()) {
+ old := synctest333Active
+ synctest333Active = true
+ defer func() { synctest333Active = old }()
+ f()
+}
+func InternalSynctest_inBubble(_ any, f func()) { InternalSynctest_Run(f) }
+func InternalSynctest_associate(p unsafe.Pointer) int {
+ if !synctest333Active { return 0 }
+ synctest333Associations[p] = true
+ return 1 // internal/synctest.CurrentBubble
+}
+func InternalSynctest_isAssociated(p unsafe.Pointer) bool { return synctest333Active && synctest333Associations[p] }
+func InternalSynctest_disassociate(p unsafe.Pointer) { delete(synctest333Associations, p) }
+func InternalSynctest_acquire() any { if synctest333Active { return 1 }; return nil }
+func InternalSynctest_release(any) {} // no bubble liveness counter
+func TestingSynctest_testingSynctestTest(t *testing.T, f func(*testing.T)) bool {
+ f(t)
+ return !t.Failed()
+}
