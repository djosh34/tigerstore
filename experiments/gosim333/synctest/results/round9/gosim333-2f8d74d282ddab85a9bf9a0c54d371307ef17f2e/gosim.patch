+package go123
+
+import (
+ "context"
+ "runtime/pprof" //gosim:notranslate
+ "github.com/jellevandenhooff/gosim/gosimruntime"
+)
+
+// Diagnostic only: no synctest bubble exists until internal/synctest is ported.
+func Time_runtimeIsBubbled() bool { return synctest333Active }
+func InternalSynctest_IsInBubble() bool { return synctest333Active }
+func Sync_runtime_SemacquireWaitGroup(s *uint32, durable bool) {
+ // Experiment: durable waits use the same gosim semaphore; no bubble idle accounting.
+ Sync_runtime_Semacquire(s)
+}
+
+func Time_runtimeNow() (int64, int32, int64) { sec, nsec, mono := Time_now(); if synctest333Active { mono = 0 }; return sec, nsec, mono }
+
+func CryptoInternalConstanttime_boolToUint8(b bool) uint8 { if b { return 1 }; return 0 }
+
+func InternalSync_runtime_rand() uint64 { return gosimruntime.Fastrand64() }
+
+func InternalRuntimeAtomic_LoadAcquintptr(ptr *uintptr) uintptr {
+ return Sync_runtime_LoadAcquintptr(ptr)
+}
+
+func InternalRuntimeAtomic_StoreReluintptr(ptr *uintptr, value uintptr) {
+ Sync_runtime_StoreReluintptr(ptr, value)
+}
+
+func PprofWithLabels(ctx context.Context, labels pprof.LabelSet) context.Context {
+ panic(gosimruntime.MissingHook("runtime/pprof.WithLabels"))
+}
+func PprofSetGoroutineLabels(ctx context.Context) {
+ panic(gosimruntime.MissingHook("runtime/pprof.SetGoroutineLabels"))
+}
